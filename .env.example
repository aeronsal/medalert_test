# ==============================================================================
# MedAlert Environment Variables Template (.env.example)
# Copy this file to .env and fill in the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite - Exposed to browser via import.meta.env)
# IMPORTANT: Only variables prefixed with VITE_ are accessible to client code.
# NEVER place database passwords, private API keys, or session secrets here!
# ------------------------------------------------------------------------------
VITE_APP_NAME=MedAlert
VITE_API_BASE_URL=http://localhost:5001/api
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Vite - Exposed to browser via import.meta.env)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Node.js - process.env only, private)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Private - Node.js backend only)
# Note: The existing client uses browser IndexedDB/LocalStorage ('medalert_db').
# When deploying or connecting an external database, configure credentials below:
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/medalert_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medalert_db
DB_USER=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY SECRETS (Private - Backend only)
# ------------------------------------------------------------------------------
JWT_SECRET=
SESSION_SECRET=
